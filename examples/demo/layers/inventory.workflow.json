    { "id": "deduct", "lane": "core", "col": 3, "type": "backend", "label": "扣减落库", "sublabel": "原子递减", "tag": "事务保护", "width": 132 },
    { "id": "release", "lane": "core", "col": 4, "type": "security", "label": "超时释放", "sublabel": "解除预留", "width": 132 },
